# Copy to .env.local for local development, and add the same variables
# in Vercel → Project → Settings → Environment Variables.

# Brevo API key (Brevo → SMTP & API → API Keys). Keep it secret.
BREVO_API_KEY=

# Where new inquiries from the website form are delivered.
INQUIRY_TO_EMAIL=

# Sender for both emails. Must be a verified sender (or on a verified domain) in Brevo.
INQUIRY_FROM_EMAIL=info@webcafe.africa
